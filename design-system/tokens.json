{
  "$schema": "formatdesk-design-tokens/v1",
  "description": "FormatDesk Design System — машинно-читаемые токены. CSS-версия: tokens.css. Происхождение значений — README.md, раздел «Карта референсов».",
  "color": {
    "background":      { "value": "#F5F2EB", "role": "background", "comment": "Фон страницы, тёплый крем (реф. 7)" },
    "surface":         { "value": "#FFFFFF", "role": "surface",    "comment": "Карточки, таблицы, диалоги" },
    "surfaceSunken":   { "value": "#EFECE2", "role": "surface",    "comment": "Утопленные зоны; фон лендинга" },
    "surfaceWarm":     { "value": "#FAF7EF", "role": "surface",    "comment": "Шапки таблиц, чередование" },
    "text":            { "value": "#1A1A1A", "role": "text",       "comment": "Основной текст (реф. 7)" },
    "textSecondary":   { "value": "#5C5749", "role": "text",       "comment": "Вторичный текст" },
    "textDisabled":    { "value": "#A39B87", "role": "text",       "comment": "Неактивный текст" },
    "border":          { "value": "#DCC8AD", "role": "border",     "comment": "Базовая граница, песок (реф. 7)" },
    "borderSoft":      { "value": "#EAE1CF", "role": "border",     "comment": "Разделители" },
    "borderStrong":    { "value": "#B9A37F", "role": "border",     "comment": "Граница при наведении" },
    "primary":         { "value": "#1F3D2E", "role": "action",     "comment": "Главное действие, глубокий зелёный (реф. 7)" },
    "primaryHover":    { "value": "#2A5440", "role": "action" },
    "primaryActive":   { "value": "#173129", "role": "action" },
    "onPrimary":       { "value": "#FFFFFF", "role": "action" },
    "primarySoft":     { "value": "#E4EBE2", "role": "surface",    "comment": "Мягкая зелёная подложка" },
    "accent":          { "value": "#C86A4A", "role": "action",     "comment": "Терракота, декор и крупные элементы (реф. 7)" },
    "accentStrong":    { "value": "#A9502F", "role": "action",     "comment": "Терракота для текста и кнопок, контраст ≥ 4.5" },
    "accentHover":     { "value": "#8F4024", "role": "action" },
    "accentSoft":      { "value": "#F6E3D8", "role": "surface" },
    "gold":            { "value": "#D4AF37", "role": "action",     "comment": "Золото, редкие метки (реф. 7)" },
    "success":         { "value": "#44553A", "role": "status",     "comment": "Шалфей (реф. 6)" },
    "successBg":       { "value": "#EEF2E8", "role": "status" },
    "successBorder":   { "value": "#C6D2B8", "role": "status" },
    "warning":         { "value": "#8A5B12", "role": "status" },
    "warningAccent":   { "value": "#D89A3A", "role": "status",     "comment": "Янтарь (реф. 6)" },
    "warningBg":       { "value": "#FBF3E2", "role": "status" },
    "warningBorder":   { "value": "#EAD3A6", "role": "status" },
    "error":           { "value": "#A32E22", "role": "status" },
    "errorBg":         { "value": "#F9E7E3", "role": "status" },
    "errorBorder":     { "value": "#E5B7AF", "role": "status" },
    "selectionBg":     { "value": "#F6FFED", "role": "status",     "comment": "Выделение строк данных — явное решение пользователя, не менять" },
    "selectionBorder": { "value": "#D9F7BE", "role": "status",     "comment": "Выделение строк данных — явное решение пользователя, не менять" }
  },
  "font": {
    "display": { "value": "Cormorant Garamond", "fallback": "serif", "comment": "Заголовки, как на лендинге (реф. 7)" },
    "text":    { "value": "Inter", "fallback": "sans-serif", "comment": "Интерфейсный текст" },
    "mono":    { "value": "Space Mono", "fallback": "monospace", "comment": "Коды, XPath (реф. 6)" }
  },
  "fontSize": {
    "xs": "12px", "s": "13px", "m": "14px", "l": "16px",
    "xl": "20px", "2xl": "24px", "3xl": "32px", "4xl": "40px"
  },
  "lineHeight": { "tight": 1.2, "base": 1.5, "loose": 1.65 },
  "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "grid": { "container": "1080px", "breakpointNarrow": "760px" },
  "radius": { "s": "4px", "m": "8px", "l": "12px", "pill": "999px" },
  "shadow": {
    "s": "0 1px 2px rgba(26,26,26,.07)",
    "m": "0 4px 16px rgba(31,61,46,.10)",
    "l": "0 12px 40px rgba(31,61,46,.16)"
  },
  "focus": { "ring": "0 0 0 3px rgba(31,61,46,.25)" },
  "motion": { "fast": "120ms", "base": "200ms", "ease": "cubic-bezier(.2,.7,.3,1)", "reducedMotion": "respects prefers-reduced-motion" }
}
